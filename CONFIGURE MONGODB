11. Farmer Service
Create:

app/services/farmer_service.py

from datetime import datetime, timezone

from app.db.collections import farmers_collection


def create_farmer(
    name: str,
    phone: str | None = None,
    language: str = "en"
):

    farmer = {
        "name": name,
        "phone": phone,
        "language": language,
        "created_at": datetime.now(timezone.utc)
    }

    result = farmers_collection.insert_one(
        farmer
    )

    farmer["_id"] = str(
        result.inserted_id
    )

    return farmer


def get_farmer(
    farmer_id
):

    from bson import ObjectId

    farmer = farmers_collection.find_one(
        {
            "_id": ObjectId(farmer_id)
        }
    )

    if farmer:

        farmer["_id"] = str(
            farmer["_id"]
        )

    return farmer

12. Farmer API
Create:

app/api/routes/farmers.py

from fastapi import APIRouter, HTTPException

from pydantic import BaseModel

from app.services.farmer_service import (
    create_farmer,
    get_farmer
)


router = APIRouter(
    prefix="/farmers",
    tags=["Farmers"]
)


class FarmerRequest(BaseModel):

    name: str

    phone: str | None = None

    language: str = "en"


@router.post("")
def add_farmer(
    request: FarmerRequest
):

    return create_farmer(
        name=request.name,
        phone=request.phone,
        language=request.language
    )


@router.get("/{farmer_id}")
def farmer(
    farmer_id: str
):

    result = get_farmer(
        farmer_id
    )

    if not result:

        raise HTTPException(
            status_code=404,
            detail="Farmer not found"
        )

    return result

