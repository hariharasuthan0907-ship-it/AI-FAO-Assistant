Create:

app/services/weather_service.py

Example:

import httpx


async def get_weather(
    latitude: float,
    longitude: float
):

    url = "WEATHER_API_URL"

    params = {
        "latitude": latitude,
        "longitude": longitude
    }

    async with httpx.AsyncClient() as client:

        response = await client.get(
            url,
            params=params
        )

        response.raise_for_status()

        return response.json()

