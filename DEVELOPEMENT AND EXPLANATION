18. Basic RAG Service
Create:

app/ai/rag.py

from pathlib import Path


DOCUMENT_PATH = Path(
    "data/documents"
)


def load_documents():

    documents = []

    if not DOCUMENT_PATH.exists():
        return documents

    for file in DOCUMENT_PATH.glob("*.txt"):

        text = file.read_text(
            encoding="utf-8"
        )

        documents.append({
            "filename": file.name,
            "content": text
        })

    return documents


def retrieve_documents(
    question: str
):

    documents = load_documents()

    question_words = set(
        question.lower().split()
    )

    results = []

    for document in documents:

        words = set(
            document["content"]
            .lower()
            .split()
        )

        score = len(
            question_words.intersection(words)
        )

        if score > 0:

            results.append({
                "score": score,
                "filename": document["filename"],
                "content": document["content"]
            })

    results.sort(
        key=lambda x: x["score"],
        reverse=True
    )

    return results[:3]

This is only an MVP implementation.

The production version should use embeddings and pgvector.

19. Chat API
Create:

app/api/routes/chat.py

from fastapi import APIRouter

from pydantic import BaseModel

from app.ai.llm import ask_ai
from app.ai.rag import retrieve_documents


router = APIRouter(
    prefix="/chat",
    tags=["Chat"]
)


class ChatRequest(BaseModel):

    question: str

    language: str = "en"


@router.post("")
def chat(
    request: ChatRequest
):

    documents = retrieve_documents(
        request.question
    )

    context = "\n\n".join(
        document["content"]
        for document in documents
    )

    answer = ask_ai(
        question=request.question,
        context=context,
        language=request.language
    )

    return {
        "answer": answer,
        "sources": [
            document["filename"]
            for document in documents
        ]
    }

