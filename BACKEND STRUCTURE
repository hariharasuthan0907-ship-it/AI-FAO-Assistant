14. Main application
app/main.py

from fastapi import FastAPI

from app.core.config import settings
from app.db.database import Base, engine

from app.api.routes import (
    chat,
    crops,
    farmers,
    health,
)


Base.metadata.create_all(
    bind=engine
)


app = FastAPI(
    title=settings.app_name,
    version="1.0.0",
    description="AI assistant for agricultural and FAO-related knowledge.",
)


app.include_router(
    health.router,
    prefix="/api/v1",
)

app.include_router(
    chat.router,
    prefix="/api/v1",
)

app.include_router(
    farmers.router,
    prefix="/api/v1",
)

app.include_router(
    crops.router,
    prefix="/api/v1",
)


@app.get("/")
def root():

    return {
        "name": settings.app_name,
        "status": "running",
    }

