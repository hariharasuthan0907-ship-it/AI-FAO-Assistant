8. AI service
app/services/ai_service.py

from openai import OpenAI

from app.core.config import settings


client = OpenAI(
    api_key=settings.openai_api_key
)


SYSTEM_PROMPT = """
You are AI-FAO-Assistant.

You are an agricultural information assistant.

Your responsibilities:
- Answer agriculture-related questions.
- Explain crop management clearly.
- Help farmers understand pests and diseases.
- Provide irrigation and soil-management guidance.
- Use retrieved agricultural knowledge when available.
- Clearly distinguish known information from uncertainty.
- Do not invent agricultural facts.
- Encourage users to consult qualified agricultural experts
  for serious crop disease, pesticide, livestock, or food-safety
  decisions.

Answer in the user's requested language.
"""


def generate_answer(
    question: str,
    context: str = "",
    language: str = "en",
) -> str:

    prompt = f"""
Language: {language}

Agricultural knowledge:

{context}

Farmer question:

{question}
"""

    response = client.chat.completions.create(
        model=settings.openai_model,
        messages=[
            {
                "role": "system",
                "content": SYSTEM_PROMPT,
            },
            {
                "role": "user",
                "content": prompt,
            },
        ],
    )

    return response.choices[0].message.content

9. RAG service
app/services/rag_service.py

Start with a simple local knowledge implementation:

from pathlib import Path

from app.core.config import settings


def load_documents() -> list[str]:
    documents = []

    path = Path(settings.fao_knowledge_path)

    if not path.exists():
        return documents

    for file in path.glob("*.txt"):
        try:
            documents.append(
                file.read_text(
                    encoding="utf-8"
                )
            )
        except Exception:
            continue

    return documents


def retrieve_context(
    question: str,
    max_documents: int = 3,
) -> str:

    documents = load_documents()

    if not documents:
        return ""

    # Basic MVP retrieval.
    # Replace with embeddings + pgvector for production.

    question_words = set(
        question.lower().split()
    )

    scored = []

    for document in documents:

        words = set(
            document.lower().split()
        )

        score = len(
            question_words.intersection(words)
        )

        scored.append(
            (score, document)
        )

    scored.sort(
        key=lambda x: x[0],
        reverse=True,
    )

    selected = [
        document
        for score, document in scored[:max_documents]
        if score > 0
    ]

    return "\n\n".join(selected)

10. Chat API
app/api/routes/chat.py

from fastapi import APIRouter, Depends
from sqlalchemy.orm import Session

from app.db.database import get_db
from app.db.models import (
    Conversation,
    Message,
)
from app.schemas.chat import (
    ChatRequest,
    ChatResponse,
)
from app.services.ai_service import generate_answer
from app.services.rag_service import retrieve_context


router = APIRouter(
    prefix="/chat",
    tags=["AI Chat"],
)


@router.post(
    "",
    response_model=ChatResponse,
)
def chat(
    request: ChatRequest,
    db: Session = Depends(get_db),
):

    conversation = Conversation(
        farmer_id=request.farmer_id
    )

    db.add(conversation)
    db.commit()
    db.refresh(conversation)

    user_message = Message(
        conversation_id=conversation.id,
        role="user",
        content=request.message,
    )

    db.add(user_message)
    db.commit()

    context = retrieve_context(
        request.message
    )

    answer = generate_answer(
        question=request.message,
        context=context,
        language=request.language,
    )

    assistant_message = Message(
        conversation_id=conversation.id,
        role="assistant",
        content=answer,
    )

    db.add(assistant_message)
    db.commit()

    return ChatResponse(
        answer=answer,
        conversation_id=conversation.id,
        sources=[],
    )

11. Farmer API
app/api/routes/farmers.py

from fastapi import APIRouter, Depends
from sqlalchemy.orm import Session

from app.db.database import get_db
from app.db.models import Farmer


router = APIRouter(
    prefix="/farmers",
    tags=["Farmers"],
)


@router.post("")
def create_farmer(
    name: str,
    phone: str | None = None,
    language: str = "en",
    db: Session = Depends(get_db),
):

    farmer = Farmer(
        name=name,
        phone=phone,
        language=language,
    )

    db.add(farmer)
    db.commit()
    db.refresh(farmer)

    return farmer


@router.get("/{farmer_id}")
def get_farmer(
    farmer_id: int,
    db: Session = Depends(get_db),
):

    farmer = (
        db.query(Farmer)
        .filter(Farmer.id == farmer_id)
        .first()
    )

    if not farmer:
        return {
            "error": "Farmer not found"
        }

    return farmer

